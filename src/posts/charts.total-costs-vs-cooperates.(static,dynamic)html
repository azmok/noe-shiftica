<style>
:root {
  --bg: #0c0c0f;
  --surface: #161619;
  --surface2: #1e1e23;
  --border: #2a2a30;
  --text: #e8e8ec;
  --text2: #9898a4;
  --accent-green: #22c55e;
  --accent-green-dim: #166534;
  --accent-red: #ef4444;
  --accent-red-dim: #7f1d1d;
  --accent-amber: #f59e0b;
  --accent-blue: #3b82f6;
  --accent-purple: #a855f7;
  --noe: #8b5cf6;
}
* { margin:0; padding:0; box-sizing:border-box; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Noto Sans JP', sans-serif;
  font-weight: 300;
  line-height: 1.7;
  padding: 40px 20px 80px;
}
.container { max-width: 1200px; margin: 0 auto; }

h1 {
  font-size: 28px;
  font-weight: 800;
  margin-bottom: 6px;
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, #fff 0%, #a0a0b0 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.subtitle {
  font-size: 13px;
  color: var(--text2);
  margin-bottom: 40px;
  font-family: 'JetBrains Mono', monospace;
}

.section-title {
  font-size: 18px;
  font-weight: 800;
  margin: 48px 0 8px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-title .num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  background: var(--accent-blue);
  color: #fff;
  padding: 2px 8px;
  border-radius: 4px;
}
.section-desc {
  font-size: 13px;
  color: var(--text2);
  margin-bottom: 20px;
}

/* TABLE STYLES */
.table-wrap {
  overflow-x: auto;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--surface);
  margin-bottom: 24px;
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  min-width: 900px;
}
thead th {
  background: var(--surface2);
  padding: 12px 14px;
  text-align: center;
  font-weight: 600;
  font-size: 12px;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
thead th:first-child {
  text-align: left;
  min-width: 140px;
}
thead th.static-h { color: var(--accent-blue); }
thead th.dynamic-h { color: var(--accent-purple); }

tbody td {
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  text-align: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
}
tbody td:first-child {
  text-align: left;
  font-family: 'Noto Sans JP', sans-serif;
  font-weight: 600;
  font-size: 13px;
  background: var(--surface2);
}
tbody tr:last-child td { border-bottom: none; }
tbody tr:hover td { background: rgba(255,255,255,0.02); }
tbody tr:hover td:first-child { background: var(--surface2); }

.label-sub {
  display: block;
  font-size: 10px;
  color: var(--text2);
  font-weight: 300;
}
.val-low { color: var(--accent-green); }
.val-mid { color: var(--accent-amber); }
.val-high { color: var(--accent-red); }
.val-noe { color: var(--noe); font-weight: 700; }

.chip {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
}
.chip-green { background: var(--accent-green-dim); color: var(--accent-green); }
.chip-red { background: var(--accent-red-dim); color: var(--accent-red); }
.chip-amber { background: rgba(245,158,11,0.15); color: var(--accent-amber); }

/* NOE ROW HIGHLIGHT */
.noe-row td {
  background: rgba(139,92,246,0.06) !important;
  border-bottom-color: rgba(139,92,246,0.2);
}
.noe-row td:first-child {
  background: rgba(139,92,246,0.12) !important;
  color: var(--noe);
}

/* INSIGHTS SECTION */
.insights-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
  margin-top: 24px;
}
.insight-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
}
.insight-card .ic-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 4px;
}
.insight-card .ic-label {
  font-size: 12px;
  color: var(--text2);
  line-height: 1.5;
}

.footnote {
  font-size: 11px;
  color: var(--text2);
  margin-top: 40px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  line-height: 1.8;
}
.footnote a { color: var(--accent-blue); text-decoration: none; }
</style>
</head>
