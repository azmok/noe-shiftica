{
  "hooks": {
		"SessionStart": [
		  {
		    "hooks": [
		      {
		        "type": "command",
		        "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-learning.mjs\" sync",
		        "timeout": 60
		      }
		    ]
		  }
		],
		"PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-shell-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ai-learning.mjs\" push",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request"
    ]
  }
}
