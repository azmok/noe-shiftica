# ============================================================
# Noe Shiftica — Git Ignore Configuration
# ============================================================
#
# Policy:
#   Public  : Source code, architecture, documentation,
#             AI instructions, skills, CI/CD workflows.
#
#   Private : Credentials, local configurations, AI sessions,
#             personal data, runtime data, and backups.
#
# Reference:
# https://git-scm.com/docs/gitignore
#
# ============================================================


# ============================================================
# 01. Dependencies
# ============================================================

node_modules/
/.pnp
.pnp.*

.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/


# ============================================================
# 02. Testing & Coverage
# ============================================================

/coverage/
/playwright-report/
/test-results/
/.nyc_output/


# ============================================================
# 03. Next.js & Build Artifacts
# ============================================================

/.next/
/out/
/build/
/dist/
.turbo/
*.tsbuildinfo
next-env.d.ts


# ============================================================
# 04. Environment Variables
# ============================================================

.env
.env.*

# Public environment templates
!.env.example
!.env.test.example
!.env.development.example
!.env.production.example
!.env.local.example


# ============================================================
# 05. Cloud & Hosting Platforms
# ============================================================

# Vercel
.vercel/

# Netlify
.netlify/

# Firebase
.firebase/
firebase-debug.log*
firebase-debug.*.log*
firestore-debug.log*
ui-debug.log*

# Firebase App Hosting operation files
*_backends.json
backends.json
apphosting_backends.json
*_rollouts.json
rollouts.json
apphosting_rollouts.json

# Neon
.neon/


# ============================================================
# 06. Credentials & Service Accounts
# ============================================================

# Google Cloud / GCS
noe-shiftica-*.json

# Service account credentials
*-adminsdk*.json
service-account*.json
*-credentials.json
firebase-admin*.json

credentials.json
credentials.local.json
oauth_creds.json
auth.json

# Secret files
secret.txt
secrets.json
secrets.local.json
secrets/
.secrets/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt

# Package manager credentials
.npmrc.local
.pypirc

# SSH credentials
id_rsa
id_ed25519


